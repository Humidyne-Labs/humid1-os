CompileFlags:
  CompilationDatabase: examples/H1OS/build_dev
  Add:
    - -Wno-unknown-attributes
    - -Wno-macro-redefined
    - -Wno-unused-variable
  Remove:
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -f*
    - -m*

Diagnostics:
  UnusedIncludes: Strict
  Suppress:
    - "-Wunused-function"
  ClangTidy:
    Remove:
      - modernize*
      - "*"
