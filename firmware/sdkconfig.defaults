# ==============================================================================
# humid1-os Base Hardware & Middleware Configuration (ESP-IDF v6.1+)
# Target: Waveshare ESP32-S3 ePaper 1.54" V2 (ESP32-S3-PICO-1-N8R8)
# ==============================================================================

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Flash (8 MB QIO @ 80 MHz) & Partition Table ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Octal PSRAM (8 MB @ 80 MHz) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# --- Dynamic Power Management & Tickless Idle ---
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_FREERTOS_HZ=1000

# --- ULP-RISC-V Reactive Monitor ---
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096
CONFIG_ESP_SLEEP_WAIT_FLASH_READY_EXTRA_DELAY=2000

# --- LVGL v9.6.0 Monochrome 1-Bit Engine ---
CONFIG_LV_COLOR_DEPTH_1=y
CONFIG_LV_DPI_DEF=188
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_THORVG_INTERNAL=n
CONFIG_LV_USE_THORVG_EXTERNAL=n
CONFIG_LV_USE_VECTOR_GRAPHIC=n
CONFIG_LV_USE_LOTTIE=n
CONFIG_LV_USE_SVG=n
CONFIG_LV_USE_MATRIX=n
CONFIG_LV_USE_FLOAT=n
CONFIG_LV_USE_OBJ_ID=n
CONFIG_LV_USE_OBJ_ID_BUILTIN=n
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_14=n
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=n

# --- Networking, TLS & BLE Provisioning ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_LOCAL_HOSTNAME="humid1-os"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# --- FATFS Long Filenames ---
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
